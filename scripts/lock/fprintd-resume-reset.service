# Install: sudo install -m644 scripts/lock/fprintd-resume-reset.service /etc/systemd/system/
#          sudo systemctl daemon-reload && sudo systemctl enable fprintd-resume-reset.service
# Why: modules/lock/PamFingerprint.qml (fprintd#216: a verify across a sleep jams fprintd).
# TEMP WORKAROUND (fprintd#216, fixed by fprintd MR !259): remove this unit
# (`systemctl disable`, delete from /etc/systemd/system) once an fprintd
# release (> 1.94.5) contains !259 and a lid sleep with the lock up leaves
# the finger working without it.
[Unit]
Description=Restart fprintd after resume (clears a verify interrupted by suspend, fprintd#216)
After=suspend.target hibernate.target hybrid-sleep.target suspend-then-hibernate.target

[Service]
Type=oneshot
ExecStart=/usr/bin/systemctl try-restart fprintd.service
TimeoutStartSec=30

[Install]
WantedBy=suspend.target hibernate.target hybrid-sleep.target suspend-then-hibernate.target
